{
  "name": "vdeploy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "vps:baseline": "node scripts/vps-baseline.mjs",
    "vps:verify": "node scripts/vps-baseline.mjs --verify"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "turbo": "^2.11.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
