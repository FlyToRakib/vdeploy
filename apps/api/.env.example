# VDeploy API configuration. Every value is validated at startup; the process
# refuses to start on a missing or malformed value. No real values here.

# development | test | production
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Postgres 16+ connection string
DATABASE_URL=postgres://vdeploy:CHANGE_ME@localhost:5432/vdeploy

# The dashboard origin — the only origin allowed to send cookie-authenticated writes
PUBLIC_URL=https://vdeploy.example.com

# 32 random bytes as 64 hex characters (openssl rand -hex 32).
# Signs approvals; rotating it voids every outstanding approval.
APPROVAL_KEY=

# 32 random bytes as 64 hex characters (openssl rand -hex 32).
# Wraps every project's secret key. Keep a copy outside this server and out of
# database backups: without it no stored secret can be opened, by anyone.
SECRETS_KEY=

# Signs sessions and encrypts two-factor secrets. At least 32 random characters
# (openssl rand -base64 48). Changing it signs everyone out.
AUTH_SECRET=

# Outgoing email for invitations, password resets and sign-in alerts:
# smtps://user:password@smtp.example.com:465 — without it, email is not sent.
SMTP_URL=
MAIL_FROM=VDeploy <no-reply@vdeploy.example.com>

# Reject passwords found in known breaches (HaveIBeenPwned range API; only a
# 5-character hash prefix leaves the server). true | false
BREACHED_PASSWORD_CHECK=true
# Check from the control plane that each server's ports 80/443 are reachable (true/false).
REACHABILITY_CHECK=true

# Ed25519 seed (32 random bytes as 64 hex characters: openssl rand -hex 32).
# Signs every frame sent to agents; agents pin its public key at enrollment,
# so changing it disconnects every server until they are re-enrolled.
CONTROL_PLANE_KEY=
# Let notification webhooks reach private addresses (LAN-only installs). Off: internet only.
WEBHOOK_ALLOW_PRIVATE=false
# The VDeploy GitHub App (docs/adr/0010-github-app.md): set all of these or none.
# Without them, GitHub works for public repositories only.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# A path to the app's private key (.pem file), not the key itself.
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Signing in with GitHub or Google (optional). An OAuth app of each, separate
# from the GitHub App above, with its callback at
# <PUBLIC_URL>/api/auth/callback/github (or /google). Each pair, or neither.
# New accounts made this way still need an invitation unless sign-up is open.
SIGN_IN_GITHUB_CLIENT_ID=
SIGN_IN_GITHUB_CLIENT_SECRET=
SIGN_IN_GOOGLE_CLIENT_ID=
SIGN_IN_GOOGLE_CLIENT_SECRET=

# Where each signed-in session roughly is (optional): a MaxMind GeoLite2 City or
# Country database (.mmdb), mounted into the container. Without it no location
# is shown; VDeploy never asks a service on the internet where an address is.
GEOIP_DATABASE=

# The assistant (bring your own key). Without a key the assistant is simply off
# and everything else works as usual. claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# Point the model client at a compatible endpoint; leave empty for the Anthropic API.
ANTHROPIC_BASE_URL=

# Any model that speaks the OpenAI shape, including one on your own server.
# Set OPENAI_BASE_URL to use it instead of the Anthropic API; AI_MODEL is then
# that endpoint's model name.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# What a million tokens costs there, so the spend cap can count money. VDeploy
# cannot know a third party's prices, and a made-up number would stop an
# assistant that is free to run — so an undeclared model costs nothing.
OPENAI_PRICE_INPUT=
OPENAI_PRICE_OUTPUT=

# GitHub Enterprise Server: where its API and its pages are. The defaults are
# github.com. (GitLab and Bitbucket are connected in the dashboard, with a
# read-only access token, and need nothing here.)
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com

# Where the agent binaries for the one-command installer are, inside the image.
AGENT_BINARIES_DIR=/app/agent

# Which resolvers the worker asks when checking a domain (ip or ip:port,
# comma-separated). Empty uses the system's, which on a machine behind a
# split-horizon resolver can answer differently from the internet.
DNS_SERVERS=
